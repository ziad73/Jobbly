# Database
POSTGRES_DB=jobbly
POSTGRES_USER=my_user
POSTGRES_PASSWORD=change-me
# Host-side port for local dev access (compose internal traffic uses 5432)
# 5433 avoids clashing with a Postgres already running on the host
POSTGRES_PORT=5433

# JWT signing (generate: openssl rand -base64 64)
JWT_KEY=change-me-at-least-32-characters-long
JWT_ISSUER=http://localhost:5044
JWT_AUDIENCE=http://localhost:5044

# API host port
API_PORT=5044
