{
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "ConnectionStrings": {
    "jobblydb": "Host=localhost;Port=5433;Database=jobbly;Username=my_user;Password=1234"
  },
  "Providers": {
    "Sources": {
      "greenhouse": {
        "Name": "Greenhouse",
        "BaseUrl": "https://boards-api.greenhouse.io/v1/board/",
        "RefreshIntervalMinutes": 180
      },
      "lever": {
        "Name": "Lever",
        "BaseUrl": "https://api.lever.co/v0/postings/",
        "RefreshIntervalMinutes": 180
      }
    }
  },
  "Pipeline": {
    "DefaultRefreshIntervalMinutes": 180,
    "MaxRetryAttempts": 5,
    "StaleArchiveAfterDays": 30
  },
  "JwtSettings": {
    "Key": "",
    "Issuer": "http://localhost:5044",
    "Audience": "http://localhost:5044",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  }
}
